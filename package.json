{
  "name": "vscode-jsp-lang",
  "displayName": "JSP Language Support (HTML/JS Embedded)",
  "description": "JSP syntax highlighting + IntelliSense for embedded HTML and JavaScript",
  "version": "0.0.1",
  "publisher": "local-dev",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:jsp"],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jsp",
        "aliases": ["JSP", "jsp"],
        "extensions": [".jsp", ".jspx", ".jspf", ".tag"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jsp",
        "scopeName": "text.html.jsp",
        "path": "./syntaxes/jsp.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.css": "css",
          "source.java": "java"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
