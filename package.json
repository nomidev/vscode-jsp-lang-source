{
  "name": "vscode-jsp-lang",
  "displayName": "JSP Language Support (HTML/JS Embedded)",
  "description": "JSP syntax highlighting + IntelliSense for embedded HTML and JavaScript",
  "version": "0.7.0",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:jsp"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jsp",
        "aliases": [
          "JSP",
          "jsp"
        ],
        "extensions": [
          ".jsp",
          ".jspx",
          ".jspf",
          ".tag"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jsp",
        "scopeName": "text.html.jsp",
        "path": "./syntaxes/jsp.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.css": "css",
          "source.java": "java"
        }
      }
    ],
    "configuration": {
      "title": "JSP Language Support",
      "properties": {
        "jsp.javascript.globalScopeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "이 폴더(워크스페이스 루트 기준 상대경로) 안의 .js 파일은 <script src>로 명시적으로 연결되어 있지 않아도 항상 전역 스코프에 포함됩니다. AJAX 등으로 런타임에 동적으로 로드되는 스크립트처럼 정적 분석으로 추적할 수 없는 파일에 사용하세요. 예: [\"src/main/webapp/js/common\"]"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -b",
    "bundle": "node esbuild.js",
    "watch": "tsc -b -w",
    "package": "bash scripts/pack.sh",
    "postinstall": "cd client && npm install && cd ../server && npm install"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.4.5"
  }
}